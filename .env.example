# Copy to .env if needed. Environment variables override this optional file.
# Relative Chroma paths resolve from the project directory.
CHROMA_PATH=storage/chroma
CHROMA_COLLECTION=support_tickets
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
HEALTHCHECK_TIMEOUT_SECONDS=3
# JSON array of exact browser origins; no cross-origin access by default.
CORS_ALLOWED_ORIGINS=[]
# Example: CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Docker Compose only: host Ollama address and loopback-published API port.
# These do not change the native Python application's Ollama URL.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
SUPPORT_API_PORT=8000
